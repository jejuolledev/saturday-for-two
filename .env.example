# Copy to .env.local and fill in. Never commit real keys.
QLOO_API_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=your-hackathon-key

# Optional: the language model that plans (any OpenAI-compatible /chat/completions endpoint).
# Leave LLM_BASE_URL empty to run the rule-based planner (the page says which one planned).
# Nebius Token Factory (NVIDIA Nemotron):
#   LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
#   LLM_API_KEY=your-nebius-key
#   LLM_MODEL=<model id from the Token Factory model list, e.g. a Nemotron model>
# Meterless Nightshift on this Mac (the key is read from Nightshift's runtime-token file):
#   LLM_BASE_URL=http://127.0.0.1:8088/v1
#   LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional extra JSON merged into each request body, e.g. {"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY=
# Time budget for one plan in ms (Qloo + model). The hosted function allows up to 300 s.
PLAN_BUDGET_MS=90000
